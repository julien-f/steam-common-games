#!/bin/sh
set -e

# What CI runs, so a push that passes here passes CI (its fresh `npm ci` aside). The checks run on
# the working tree, so it must be exactly the commit being pushed.
head=$(git rev-parse HEAD)
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = 0000000000000000000000000000000000000000 ] && continue # deleting a ref
  if [ "$(git rev-parse "$local_sha^{commit}")" != "$head" ]; then
    echo "pre-push: $local_ref isn't HEAD; push from a checkout of it" >&2
    exit 1
  fi
done
if [ -n "$(git status --porcelain --untracked-files=normal | grep '^??')" ]; then
  echo 'pre-push: commit, remove or ignore untracked files first: the checks run on the working tree' >&2
  exit 1
fi

# Uncommitted edits to tracked files are set aside and restored, staged and unstaged apart; a patch
# in this worktree's own git dir rather than `git stash`, for the same reason as pre-commit's.
if ! git diff --quiet HEAD; then
  dir=$(git rev-parse --git-dir)
  git diff --cached --binary > "$dir/pre-push-staged.patch"
  git diff --binary > "$dir/pre-push-unstaged.patch"
  git reset -q
  git checkout -- .
  restore() {
    trap - EXIT
    git apply --allow-empty --index --whitespace=nowarn "$dir/pre-push-staged.patch" &&
      git apply --allow-empty --whitespace=nowarn "$dir/pre-push-unstaged.patch" &&
      rm "$dir/pre-push-staged.patch" "$dir/pre-push-unstaged.patch" ||
      echo "pre-push: could not restore uncommitted changes; they are in $dir/pre-push-*.patch" >&2
  }
  trap restore EXIT
  trap 'exit 130' INT TERM
fi

node scripts/check.js
# Skipped when this build and these tests already passed in full (scripts/e2e.js).
npm run -s test:e2e -- --if-changed
