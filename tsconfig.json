{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Vite resolves bare-absolute frontend imports (`/utils.ts`) against `root: 'public'`;
    // tsc has no notion of the web root, so map them onto the source tree for typechecking.
    "paths": {
      "/*": ["./public/*"]
    },
    // Solid JSX (only the .tsx files under public/ use it; vite-plugin-solid handles
    // the transform at build time, tsc just needs to parse it for typechecking).
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["public/**/*.ts", "public/**/*.tsx"]
}
