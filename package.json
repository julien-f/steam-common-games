{
  "name": "steam-common-games",
  "version": "0.4.0",
  "description": "Find games common to multiple Steam libraries",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "dev:web": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "DB_FILE= node --test test/*.test.js test/*.test.ts",
    "cache:clear": "node scripts/cache-clear.js"
  },
  "dependencies": {
    "@vates/data-table-core": "^0.13.0",
    "@vates/data-table-vanilla": "^0.13.0",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.2",
    "hls.js": "^1.5.13"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "morgan": "^1.11.0",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
