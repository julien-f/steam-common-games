{
  "name": "steam.isonoe.net",
  "version": "0.4.0",
  "description": "Find games common to multiple Steam libraries",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently -n backend,frontend -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "node --watch server.js",
    "dev:frontend": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "DB_FILE= node --test test/*.test.js test/*.test.ts",
    "cache:clear": "node scripts/cache-clear.js",
    "lint": "eslint public"
  },
  "dependencies": {
    "@solidjs/router": "^1.0.0",
    "@vates/data-table-core": "^0.13.0",
    "@vates/data-table-solid": "^0.13.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "hls.js": "^1.7.2",
    "solid-js": "^1.9.15"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@babel/plugin-syntax-jsx": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-solid": "^0.18.0",
    "morgan": "^1.12.0",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-solid": "^2.11.14"
  }
}
