# ── Steam API ─────────────────────────────────────────────────────────────────
# Required — the app will not start without this.
# Get your free key at: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# ── IsThereAnyDeal API ────────────────────────────────────────────────────────
# Optional — only required for the Bundles page. Register an app at
# https://isthereanydeal.com/apps/my/ to get a free key. Leave empty to disable
# the feature; the Bundles page will show a clear "not configured" message and
# GET /api/bundles / POST /api/bundles/resolve will return 503.
ITAD_API_KEY=

# ── Server ─────────────────────────────────────────────────────────────────────
# Address and port the server listens on.
# Use 127.0.0.1 to restrict access to this machine only.
# Use 0.0.0.0 to accept connections from other machines on the network.
HOST=127.0.0.1
PORT=3000
#
# Express "trust proxy" setting — set this when running behind a reverse proxy
# (nginx, Caddy, etc.) so that rate limiting uses the real client IP from
# X-Forwarded-For rather than the proxy's address.
# Accepts: a number of hops (1), a comma-separated list of trusted IPs/CIDRs,
# or "true"/"false". Leave unset to keep Express's default (untrusted).
# See: https://expressjs.com/en/guide/behind-proxies.html
#TRUST_PROXY=1

# ── Limits ─────────────────────────────────────────────────────────────────────
# Maximum number of Steam users per search request.
MAX_USERS=10

# Per-IP rate limits (requests per minute). Searches only count when they'd actually trigger
# a Steam library fetch — an account whose resolve/player/games (or wishlist) is already fully
# cached bypasses this limiter, same "cache hits don't count" rule DETAILS_RATE_LIMIT_MAX gets
# below, so switching between a handful of already-loaded accounts doesn't burn the budget.
# Game-details requests only count when they miss the cache (a cache hit makes no upstream call
# and is never limited), so that one can be generous. Raise DETAILS_RATE_LIMIT_MAX if first-time
# loads of very large shared libraries get throttled.
SEARCH_RATE_LIMIT_MAX=10
DETAILS_RATE_LIMIT_MAX=300
# The "look up any game" search box only ever makes one upstream call per distinct typed
# term (repeats hit the cache), so it can be looser than SEARCH_RATE_LIMIT_MAX above.
GAME_SEARCH_RATE_LIMIT_MAX=30
# The Bundles page: browsing the bundle list and resolving a bundle's games to Steam
# appids. Each distinct (country, offset, sort, ...) combination and each distinct
# ITAD game id only ever costs one upstream call apiece (repeats hit the cache), so
# this can be as loose as GAME_SEARCH_RATE_LIMIT_MAX above.
BUNDLES_RATE_LIMIT_MAX=30
# Achievements are fetched once per opened game panel (schema + one call per loaded
# account), same "cache hits don't count" skip rule as DETAILS_RATE_LIMIT_MAX above.
ACHIEVEMENTS_RATE_LIMIT_MAX=120
# Maximum number of games per POST /api/game-details/stream request (the batch endpoint
# behind loading a whole comparison/library's rating/HLTB/store details at once). Bounds how
# much work — and how many upstream Steam/HLTB calls — a single request can queue, on top of
# that route sharing DETAILS_RATE_LIMIT_MAX's per-minute budget above.
STREAM_MAX_GAMES=5000
# How many of those games one streaming request works on at a time. Not a throughput setting —
# lib/steam.js's own per-host semaphores decide the real upstream pace — but a fairness and
# cancellation one: without it a single request dispatches every appid at once, parking
# thousands of items in a shared FIFO queue that every other user then waits behind, and leaving
# them all to run to completion even after that user has navigated away. Comfortably above the
# semaphores' own concurrency, so it never becomes the bottleneck for a single request.
STREAM_CONCURRENCY=16

# Hard ceilings on how many requests this process will make to ONE third-party service (Steam's
# store, Steam's Web API, HLTB, ITAD, ProtonDB — the groups in GET /api/metrics) per hour and
# per day. A backstop, not a throttle: sized to sit well above normal traffic, so nothing
# legitimate reaches them. Unlike every other limit here they are global rather than per-IP,
# which is what makes them the only thing protecting the API keys themselves — a quota doesn't
# care how many different clients spent it, and neither does a retry loop in this app's own
# code. Past a ceiling, calls to that service fail (502) until the window rolls over, which is
# a far better outcome than a key being exhausted or revoked. Set to 0 to disable.
# Size them from GET /api/metrics' own sinceRestart counts after the app has been running.
OUTBOUND_HOURLY_MAX=5000
OUTBOUND_DAILY_MAX=50000

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite database file. Currently holds the cache tables; named db.sqlite rather
# than cache.db because it is intended to hold non-cache application data too.
# Set to empty to use an in-memory database (data is lost on restart).
DB_FILE=db.sqlite
#
# How long to cache each data type before re-fetching. These are deliberately long: every
# tier below is refreshable on demand from the UI, so freshness is something the user asks
# for when they need it rather than something the app pays for continuously —
#   - owned games / profile / wishlist: "↻ Refresh" on Home's Account card and above the
#     Owned/Wishlist lists, next to an "Updated <when>" readout of this very cache's age
#   - rating/HLTB/store metadata/tags/news/DLC for one game: the side panel's own "↻"
#   - ITAD prices: "↻ Refresh prices" on a wishlist/bundle list
#   - bundle listings: "↻ Refresh" on the bundle browse page
# Shortening these does not make the app more correct — it just spends more upstream calls
# on data nobody asked to be re-checked. Steam's store endpoints are also rate-limited hard
# enough (see lib/steam.js's storeLimit) that a cold load of a large library takes minutes,
# which is exactly what these TTLs exist to avoid repeating.
#
# Owned game libraries, player profiles, and wishlists — the only data here that changes on a
# human timescale (bought a game, edited wishlist). 7 days: the UI states how old this data is
# and offers the refresh, so the common "I just bought something" case is one click rather than
# a TTL everyone else pays for.
LIBRARY_CACHE_TTL_MINUTES=10080
#
# Per-type TTLs for game details — these barely change, so long TTLs avoid
# hammering external APIs on every run.
#
# Steam ID → SteamID64 resolution — essentially permanent (180 days). Not unbounded: a custom
# URL can be renamed and then claimed by someone else, and no refresh path forces this tier.
RESOLVE_CACHE_TTL_MINUTES=259200
# Steam review scores — drifts slowly, and the weighted score barely moves once a game has
# review volume; the side panel's ↻ forces one game (90 days)
RATING_CACHE_TTL_MINUTES=129600
# Store metadata, HLTB, tags, ProtonDB, achievement schema — rarely changes for an existing
# game; the side panel's ↻ forces one game (180 days)
META_CACHE_TTL_MINUTES=259200
# Game name → appid search results, for the "look up any game" search box — new games ship
# regularly, and a term is cheap to re-run, so this stays the shortest metadata tier (7 days)
SEARCH_CACHE_TTL_MINUTES=10080
# Recent news/announcements for a game — changes far more often than store metadata
# (patch notes, event posts); the side panel's ↻ forces one game (1 day)
NEWS_CACHE_TTL_MINUTES=1440
# IsThereAnyDeal bundle listings and per-region price lookups — a bundle can go live or
# expire at any time, and a sale starts/ends, so this is much shorter than the metadata
# tiers above. Both are refreshable on demand from the UI (the bundle browse page's ↻,
# and "↻ Refresh prices" on a wishlist/bundle list).
BUNDLES_CACHE_TTL_MINUTES=240
# ITAD identity mappings: the Steam shop id and both directions of the ITAD gid <-> Steam
# appid resolution. Nothing here is time-sensitive — a game's Steam listing doesn't move —
# so these get their own long tier instead of being thrown away every couple of hours along
# with the bundle/price data they used to share a table with. (180 days)
ITAD_ID_CACHE_TTL_MINUTES=259200
#
# Cached *misses* — a confirmed "this appid has no store page", "this game has no Steam
# listing". Worth caching (each one otherwise costs an upstream call every single time it's
# asked for) but deliberately far shorter than the tier they sit in: an unreleased game gets a
# store page, a listing gets added. (1 day)
MISS_CACHE_TTL_MINUTES=1440
# A failed vanity-URL resolve ("no such Steam account"). Shorter still: this is usually a typo
# being retried, or someone about to register that custom URL. (1 hour)
RESOLVE_MISS_CACHE_TTL_MINUTES=60
