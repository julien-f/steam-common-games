# ── Steam API ─────────────────────────────────────────────────────────────────
# Required — the app will not start without this.
# Get your free key at: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# ── Server ─────────────────────────────────────────────────────────────────────
# Address and port the server listens on.
# Use 127.0.0.1 to restrict access to this machine only.
# Use 0.0.0.0 to accept connections from other machines on the network.
HOST=127.0.0.1
PORT=3000
#
# Express "trust proxy" setting — set this when running behind a reverse proxy
# (nginx, Caddy, etc.) so that rate limiting uses the real client IP from
# X-Forwarded-For rather than the proxy's address.
# Accepts: a number of hops (1), a comma-separated list of trusted IPs/CIDRs,
# or "true"/"false". Leave unset to keep Express's default (untrusted).
# See: https://expressjs.com/en/guide/behind-proxies.html
#TRUST_PROXY=1

# ── Limits ─────────────────────────────────────────────────────────────────────
# Maximum number of Steam users per search request.
MAX_USERS=10

# Per-IP rate limits (requests per minute). Searches each trigger Steam library
# fetches, so they are limited tightly. Game-details requests only count when
# they miss the cache (a cache hit makes no upstream call and is never limited),
# so this can be generous. Raise DETAILS_RATE_LIMIT_MAX if first-time loads of
# very large shared libraries get throttled.
SEARCH_RATE_LIMIT_MAX=10
DETAILS_RATE_LIMIT_MAX=300
# The "look up any game" search box only ever makes one upstream call per distinct typed
# term (repeats hit the cache), so it can be looser than SEARCH_RATE_LIMIT_MAX above.
GAME_SEARCH_RATE_LIMIT_MAX=30

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite database file. Currently holds the cache tables; named db.sqlite rather
# than cache.db because it is intended to hold non-cache application data too.
# Set to empty to use an in-memory database (data is lost on restart).
DB_FILE=db.sqlite
#
# How long to cache each data type before re-fetching. Both the comparison page and
# the Library Explorer have a "↻ Refresh" button that bypasses these TTLs on demand
# (owned games/player/wishlist from the main search bar; rating/HLTB/store
# metadata/tags per-game from the side panel) — that's the intended way to force
# freshness for one player or one game, so these TTLs can stay generous.
#
# Owned game libraries, player profiles, and wishlists — the only data here that
# changes on a human timescale (bought a game, edited wishlist). 6 hours.
LIBRARY_CACHE_TTL_MINUTES=360
#
# Per-type TTLs for game details — these barely change, so long TTLs avoid
# hammering external APIs on every run.
#
# Steam ID → SteamID64 resolution — essentially permanent (90 days)
RESOLVE_CACHE_TTL_MINUTES=129600
# Steam review scores — drifts slowly (30 days)
RATING_CACHE_TTL_MINUTES=43200
# Store metadata, HLTB, tags — rarely changes for an existing game (60 days)
META_CACHE_TTL_MINUTES=86400
# Game name → appid search results, for the "look up any game" search box — new games
# ship regularly, so this is much shorter than the other game-details TTLs above (1 day)
SEARCH_CACHE_TTL_MINUTES=1440
